# ---------------------------------------------------------------------------
# LandCraft AI -- environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit a real key.
# ---------------------------------------------------------------------------

# Required for every /api route that calls Gemini. Without it the AI routes
# answer 400 and /api/ready reports itself unready (the editor still works).
GEMINI_API_KEY=

# Server
PORT=3000
NODE_ENV=development

# How many reverse-proxy hops to trust when deriving the client IP for rate
# limiting. 1 = a single load balancer in front of the app (Cloud Run, a
# typical nginx ingress). Set to 0 when the app is exposed directly.
# Do NOT set to a high number blindly: each trusted hop is an address a client
# could forge to bypass the limiter.
TRUST_PROXY_HOPS=1

# Requests per minute per client IP against /api/*. Each generation request
# fans out to up to three model calls, so this is the cost ceiling.
RATE_LIMIT_PER_MIN=30

# Graceful shutdown drain period, in milliseconds.
SHUTDOWN_TIMEOUT_MS=10000

# Per-model overrides. Defaults live in server.ts and are chosen from Google's
# current model list; only set these to experiment.
# MODEL_GENERATION=gemini-3.8-flash
# MODEL_VISION=gemini-3.8-flash
# MODEL_AUDIT=gemini-3.1-pro-preview
# MODEL_CHAT=gemini-3.1-pro-preview
# MODEL_COST=gemini-3.5-flash-lite

# Exposed by /api/ready for support triage; set by CI at build time.
# GIT_COMMIT=
